<Page
    x:Class="ElementBlocks.Desktop.Views.RotationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="28,14,28,28" Spacing="16" MaxWidth="760"
                    HorizontalAlignment="Left">

            <StackPanel Spacing="2">
                <TextBlock Text="轮换时间" FontSize="24" FontWeight="SemiBold"/>
                <TextBlock Text="按设定的周期，自动切换到下一个已启用的元素。切换顺序按原子序数推进，不会连续重复。"
                           FontSize="12" Opacity="0.65" TextWrapping="Wrap"/>
            </StackPanel>

            <Border Padding="16" CornerRadius="6"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid ColumnSpacing="24" RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="当前元素" FontSize="11" Opacity="0.6"/>
                    <TextBlock x:Name="CurrentText" Grid.Row="1" Grid.Column="0"
                               Text="92 铀 U" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="下一次切换" FontSize="11" Opacity="0.6"/>
                    <TextBlock x:Name="NextText" Grid.Row="1" Grid.Column="1"
                               Text="不自动切换" FontSize="14"/>
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="已启用元素" FontSize="11" Opacity="0.6"/>
                    <TextBlock x:Name="EnabledText" Grid.Row="1" Grid.Column="2"
                               Text="118 / 118" FontSize="16" FontWeight="SemiBold"/>
                </Grid>
            </Border>

            <TextBlock Text="切换间隔" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,0"/>
            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,4,0,0">
                <ComboBox x:Name="IntervalCombo" MinWidth="220"
                          SelectionChanged="IntervalCombo_SelectionChanged"/>
                <Button Content="立即切换下一个元素" Click="Next_Click" Style="{ThemeResource AccentButtonStyle}"/>
            </StackPanel>
            <TextBlock x:Name="HintText" Text="" Opacity="0.55" FontSize="11"
                       Margin="0,2,0,0" TextWrapping="Wrap"/>

            <TextBlock Text="常驻方块行为" FontSize="15" FontWeight="SemiBold" Margin="0,10,0,0"/>
            <StackPanel Spacing="6">
                <ToggleSwitch x:Name="PauseSwitch" Header="暂停轮换" OffContent="正常运行" OnContent="已暂停"
                              Toggled="PauseSwitch_Toggled"/>
                <ToggleSwitch x:Name="AutoStartSwitch" Header="开机自启" OffContent="关闭" OnContent="开启"
                              Toggled="AutoStartSwitch_Toggled"/>
                <ToggleSwitch x:Name="ClickThroughSwitch" Header="鼠标点击穿透"
                              OffContent="方块可接收点击" OnContent="点击直接落到桌面"
                              Toggled="ClickThroughSwitch_Toggled"/>
            </StackPanel>

            <TextBlock Text="外观" FontSize="15" FontWeight="SemiBold" Margin="0,10,0,0"/>
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Slider x:Name="OpacitySlider" Grid.Column="0"
                        Minimum="0.1" Maximum="1.0" StepFrequency="0.05" Value="1.0"
                        ValueChanged="OpacitySlider_ValueChanged"/>
                <TextBlock x:Name="OpacityLabel" Grid.Column="1" Text="不透明度：100%"
                           FontSize="13" VerticalAlignment="Center"/>
            </Grid>

            <Grid ColumnSpacing="20" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Spacing="6">
                    <TextBlock Text="桌面固定位置" FontSize="13"/>
                    <ComboBox x:Name="AnchorBox" HorizontalAlignment="Stretch"
                              SelectionChanged="AnchorBox_SelectionChanged">
                        <ComboBoxItem Content="左上角" Tag="TopLeft"/>
                        <ComboBoxItem Content="右上角" Tag="TopRight"/>
                        <ComboBoxItem Content="左下角" Tag="BottomLeft"/>
                        <ComboBoxItem Content="右下角" Tag="BottomRight"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="6">
                    <TextBlock x:Name="SizeLabel" Text="方块大小：132 px" FontSize="13"/>
                    <Slider x:Name="SizeSlider" Minimum="80" Maximum="320" StepFrequency="4"
                            Value="132" ValueChanged="SizeSlider_ValueChanged"/>
                </StackPanel>
            </Grid>

            <TextBlock Text="设置会自动保存到本地配置文件，重启后保留；休眠或关机期间不会补跑切换。"
                       FontSize="11" Opacity="0.55" TextWrapping="Wrap" Margin="0,10,0,0"/>
        </StackPanel>
    </ScrollViewer>
</Page>
