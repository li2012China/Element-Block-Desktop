<?xml version="1.0" encoding="utf-8"?>
<Package
    xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
    xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
    xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
    xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
    IgnorableNamespaces="uap rescap desktop">

  <Identity Name="ElementBlocksDesktop"
            Publisher="CN=Element Blocks Desktop"
            Version="1.0.1.3" />
  <Properties>
    <DisplayName>Element Blocks Desktop</DisplayName>
    <PublisherDisplayName>Element Blocks Desktop</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>桌面常驻元素方块与元素周期表轮换工具</Description>
  </Properties>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>
  <Resources>
    <Resource Language="zh-CN" />
    <Resource Language="en-US" />
  </Resources>
  <Applications>
    <Application Id="App"
                 Executable="$targetnametoken$.exe"
                 EntryPoint="$targetentrypoint$">
      <uap:VisualElements
          DisplayName="Element Blocks Desktop"
          Description="桌面常驻元素方块"
          BackgroundColor="#1E1E24"
          Square150x150Logo="Assets\Square150x150Logo.png"
          Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Square71x71Logo="Assets\Square44x44Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" />
      </uap:VisualElements>
      <Extensions>
        <!-- 开机自启：由设置页调用 StartupTask.RequestEnableAsync() 打开 -->
        <desktop:Extension Category="windows.startupTask"
                           Executable="ElementBlocks.Desktop.exe"
                           EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="ElementBlocksStartup"
                               Enabled="false"
                               DisplayName="Element Blocks Desktop" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>
  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
