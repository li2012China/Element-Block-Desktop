<Window
    x:Class="ElementBlocks.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ElementBlocks.Desktop.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Element Blocks Desktop">

    <!-- 无边框、无标题栏的常驻窗口；所有 Win32 样式在 MainWindow.xaml.cs 里施加 -->
    <Grid x:Name="Root" Background="Transparent">
        <controls:ElementBlock x:Name="Block" />
    </Grid>
</Window>
