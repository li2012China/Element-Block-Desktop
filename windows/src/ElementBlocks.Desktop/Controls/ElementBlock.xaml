<UserControl
    x:Class="ElementBlocks.Desktop.Controls.ElementBlock"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- 与参考图一致：米色方块 / 左上角原子序数 / 右上角元素符号 /
         中央中文名 / 英文名 / 底部相对原子质量。Viewbox 让任意 BlockSize 等比缩放。 -->
    <Border x:Name="RootBorder" Background="#EFE3C0"
            BorderBrush="#8C7B55" BorderThickness="1" CornerRadius="2">
        <Viewbox Stretch="Uniform" Margin="1">
            <Grid x:Name="ContentGrid" Width="132" Height="132" Padding="9,7,9,7">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="NumberText" Grid.Column="0" Text="92"
                               FontSize="17" FontFamily="Segoe UI"
                               Foreground="#2B2A28" HorizontalAlignment="Left"/>
                    <TextBlock x:Name="SymbolText" Grid.Column="1" Text="U"
                               FontSize="18" FontFamily="Segoe UI SemiBold"
                               Foreground="#2B2A28" HorizontalAlignment="Right"/>
                </Grid>

                <TextBlock x:Name="NameZhText" Grid.Row="1" Text="铀"
                           FontSize="50" FontFamily="SimSun"
                           Foreground="#2B2A28"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextAlignment="Center" Margin="0,-4,0,-2"/>

                <TextBlock x:Name="NameEnText" Grid.Row="2" Text="Uranium"
                           FontSize="15" FontFamily="Segoe UI"
                           Foreground="#2B2A28" HorizontalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>

                <TextBlock x:Name="MassText" Grid.Row="3" Text="238.0"
                           FontSize="15" FontFamily="Segoe UI SemiBold"
                           Foreground="#2B2A28" HorizontalAlignment="Center"/>
            </Grid>
        </Viewbox>
    </Border>
</UserControl>
